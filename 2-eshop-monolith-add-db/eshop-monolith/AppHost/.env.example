# Esempio di configurazione delle credenziali PostgreSQL
# Copia questo file come .env e personalizza con le tue credenziali

# Username PostgreSQL (default: postgres)
POSTGRES_USERNAME=postgres

# Password PostgreSQL (CAMBIARE ASSOLUTAMENTE in ambiente di produzione!)
# Utilizza una password robusta con almeno 12 caratteri, numeri e caratteri speciali
POSTGRES_PASSWORD=your_secure_password_here
